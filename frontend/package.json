{
  "name": "attendance-frontend-poc",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",

  "scripts": {
    "dev": "next dev -p 3015",
    "build": "next build",
    "start": "next start -p 3015",
    "lint": "eslint .",
    "electron": "electron .",
    "dist": "electron-builder --win"
  },

  "build": {
    "appId": "com.yourapp.client",
    "productName": "Attendance App",

    "files": [
      ".next/**/*",
      "public/**/*",
      "main.js",
      "package.json"
    ],

    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },

    "directories": {
      "output": "dist"
    }
  },

  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@reduxjs/toolkit": "^2.9.0",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4"
  },

  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}

